# .env.example — a template for your real settings file.
# Why it exists: the app needs to know which Supabase project to talk to.
# Copy this file to `.env.local` (which git ignores) and fill in both values.
# Find them in Supabase: Project Settings → API.

# Your project's URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# The publishable / "anon" key. It is safe in the browser because row-level
# security in the database decides what each signed-in person can read.
# NEVER put the service_role / secret key here, or anywhere in this app or in git.
VITE_SUPABASE_ANON_KEY=
