# Answers from the registration Function must never be stored by browsers or proxies.
# (Cloudflare doesn't apply this file to Function answers, so the Function also sets this
# header itself — functions/_lib/http.js. This line is the backup the contract asks for.)
/api/*
  Cache-Control: no-store
